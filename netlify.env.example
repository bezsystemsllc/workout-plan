# Copy this file to netlify.env, replace placeholder values, then import it in Netlify.
# Do not commit the real netlify.env file.

# Required only if you want AI Coach enabled.
OPENAI_API_KEY=

# Optional. Leave blank or remove to use the function default.
OPENAI_MODEL=gpt-4.1-mini

# Strongly recommended for a public AI Coach endpoint.
# Use your exact deployed origin. Examples:
# COACH_ALLOWED_ORIGIN=https://your-site.netlify.app
# COACH_ALLOWED_ORIGIN=https://your-custom-domain.com
COACH_ALLOWED_ORIGIN=

# Per-IP coach abuse limits.
COACH_RATE_LIMIT=5
COACH_RATE_WINDOW_SECONDS=900
COACH_DAILY_LIMIT=20

# Recommended for durable rate limiting across Netlify function cold starts.
# Supabase path: run supabase-rate-limit.sql in Supabase SQL Editor, then paste
# your project URL and server-side secret key here.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# If your project uses the older service_role key name, you can use this instead:
# SUPABASE_SERVICE_ROLE_KEY=

# Alternate durable rate-limit store. Leave blank when using Supabase.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Long random string used to hash IPs before storing rate-limit counters.
RATE_LIMIT_SALT=

# Optional timeout tuning.
OPENAI_TIMEOUT_MS=12000
RATE_LIMIT_TIMEOUT_MS=3000
